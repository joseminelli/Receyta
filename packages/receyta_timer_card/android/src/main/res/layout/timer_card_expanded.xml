<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="132dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/timer_block"
        android:layout_width="112dp"
        android:layout_height="132dp"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="-20dp"
        android:background="@drawable/timer_panel_bg"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timer_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:textColor="#8A8674"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/timer_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/timer_badge_bg"
                android:letterSpacing="0.1"
                android:paddingStart="7dp"
                android:paddingTop="1dp"
                android:paddingEnd="7dp"
                android:paddingBottom="1dp"
                android:text="PAUSADO"
                android:textColor="#C0392B"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/timer_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#16150F"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/timer_static"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#16150F"
            android:textSize="30sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/timer_btn1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/timer_btn_bg">

                <ImageView
                    android:id="@+id/timer_btn1_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/timer_btn1_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="#16150F"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/timer_btn2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/timer_btn_outline_bg">

                <ImageView
                    android:id="@+id/timer_btn2_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/timer_btn2_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="#16150F"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/timer_btn3"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/timer_btn_stop_bg">

                <ImageView
                    android:id="@+id/timer_btn3_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/timer_btn3_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="#16150F"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
