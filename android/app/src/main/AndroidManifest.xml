<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="Receyta"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">
        <!-- `singleTask` (era `singleTop` + `taskAffinity=""`, o padrão que o
             `flutter create` gera): abrir um `.receyta` de outro app criava
             uma tarefa/janela nova do Receyta em vez de reaproveitar a que já
             tava aberta (confirmado no aparelho — ficava com "2 apps" na
             lista de recentes). `taskAffinity=""` some porque uma activity
             sem afinidade nenhuma nunca acha a tarefa existente pra
             reaproveitar; sem essa linha ela usa a afinidade padrão (o
             próprio pacote), que é o que o `singleTask` precisa pra casar. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- `getInitialRoute()` (no MainActivity.kt) só resolve o app
                 fechado (cold start). Com o app já aberto, `singleTask`
                 reaproveita a activity via `onNewIntent` — e por padrão o
                 Flutter tem um segundo mecanismo (independente do
                 `getInitialRoute`) que empurra o dado bruto do Intent direto
                 pro GoRouter como rota nessa hora, dando o mesmo "Página não
                 encontrada" de novo, só que agora com o app já aberto
                 (confirmado no aparelho: importava certo mas caía nessa
                 tela). Desligado aqui porque o `.receyta` compartilhado é
                 tratado inteiro pelo canal do `receive_sharing_intent`
                 (`home_shell.dart`), nunca pelo GoRouter. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Aparece no "Abrir com" pra um `.receyta` recebido por outro app
                 (D5, RF-06.5). Dois filtros por dois formatos de URI
                 diferentes que já vimos na prática (checado com `adb` num
                 aparelho de verdade):
                 1. `file://` com o nome do arquivo visível no path — o
                    `pathPattern` restringe certinho pro `.receyta` aqui.
                 2. `content://` do MediaStore de Downloads (Arquivos, e
                    provavelmente qualquer app que salva antes de abrir) —
                    o path é só um id numérico (`/external/downloads/52820`),
                    sem o nome do arquivo em lugar nenhum, então `pathPattern`
                    NUNCA bate nesse caso (era o bug: o filtro antigo exigia
                    path em todo `<data>`, essa URI ficava de fora). O que dá
                    pra usar aqui é o mimeType: extensão desconhecida pro
                    Android sempre vira `application/octet-stream`
                    (confirmado via `content query` no MediaStore) — casa por
                    esse tipo específico, sem `pathPattern` nem `host`, então
                    Receyta aparece pra qualquer arquivo "binário
                    desconhecido" nessa origem (mais amplo que só `.receyta`,
                    mas é o único jeito: o Android não expõe o nome do
                    arquivo pra casar no manifesto quando o path é opaco).
                 Abrir de verdade (ler o JSON e importar) ainda não existe —
                 isso é o D3. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="file"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.receyta"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:mimeType="application/octet-stream"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
